+// Local MW4 modification: prevent excess buttons entering immediate or buffered input.
+static BOOL CALLBACK CollectMw4Buttons(const DIDEVICEOBJECTINSTANCEW* object, void* context)
+{
+    auto& buttons = *static_cast<std::vector<mw4input::ButtonObject>*>(context);
+    if (!mw4input::IsHiddenButton(object->dwType))
+        buttons.push_back({ object->guidType, object->dwType });
+    return DIENUM_CONTINUE;
+}
+
+HRESULT m_IDirectInputDeviceX::SetProxyDataFormat(LPCDIDATAFORMAT format)
+{
+    if (diVersion != 0x0700 || DevType7 != DIDEVTYPE_JOYSTICK)
+        return ProxyInterface->SetDataFormat(format);
+    std::vector<mw4input::ButtonObject> buttons;
+    HRESULT inventory = ProxyInterface->EnumObjects(CollectMw4Buttons, &buttons, DIDFT_BUTTON);
+    if (FAILED(inventory)) return inventory;
+    auto filtered = mw4input::Filter(*format, buttons);
+    DIDATAFORMAT safe = *format;
+    safe.dwNumObjs = static_cast<DWORD>(filtered.objects.size());
+    safe.rgodf = filtered.objects.empty() ? nullptr : filtered.objects.data();
+    EnterCriticalSection(&dics);
+    HRESULT hr = ProxyInterface->SetDataFormat(&safe);
+    if (SUCCEEDED(hr)) Mw4HiddenOffsets = std::move(filtered.hiddenOffsets);
+    LeaveCriticalSection(&dics);
+    return hr;
+}
