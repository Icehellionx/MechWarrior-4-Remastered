+// Local build-only refactor: named helpers avoid MSVC path-hashed lambda ordering.
+// Preserve the upstream effect transformations and copy-on-first-write contract.
+static void MakeEffectWritable(bool& modified, LPCDIEFFECT& lpeff, DIEFFECT& eff)
+{
+	if (!modified)
+	{
+		if (&eff != lpeff)
+		{
+			eff = *lpeff;
+			lpeff = &eff;
+		}
+		modified = true;
+	}
+}
+
+static bool IsConditionEffect(REFGUID guid)
+{
+	return guid == GUID_Spring || guid == GUID_Damper ||
+		guid == GUID_Friction || guid == GUID_Inertia;
+}
