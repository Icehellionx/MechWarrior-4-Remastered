# Copy to .env and fill only providers you intend to use. Never commit a real key.

AUX_REMOTE_ENABLED=false
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_ADVISER_MODEL=zai-org/GLM-5.2
FEATHERLESS_ADVERSARY_MODEL=deepseek-ai/DeepSeek-V4-Pro
FEATHERLESS_CODER_MODEL=Qwen/Qwen3-Coder-Next
FEATHERLESS_BALANCED_MODEL=Qwen/Qwen3.8-27B
FEATHERLESS_FAST_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
FEATHERLESS_LONG_CONTEXT_MODEL=MiniMaxAI/MiniMax-M3

LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_PROVIDER=ollama
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_ADVISER_MODEL=qwen3:8b
LOCAL_ADVERSARY_MODEL=mistral:7b-instruct
LOCAL_BALANCED_MODEL=gemma2:9b
LOCAL_FAST_MODEL=llama3.1:8b
LOCAL_CODER_MODEL=qwen3-coder:30b
LOCAL_FAST_CODER_MODEL=qwen2.5-coder:7b-instruct
LOCAL_VISION_MODEL=qwen2.5vl:7b
LOCAL_FAST_VISION_MODEL=gemma3:4b
LOCAL_EMBEDDING_MODEL=nomic-embed-text:latest
