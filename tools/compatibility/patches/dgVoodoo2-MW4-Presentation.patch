+volatile LONG mediaPlaybackState = 0;
+volatile LONG64 vengeanceOpeningObservedTick = 0;
+volatile LONG direct3DDeviceCount = 0;
+const LONG64 vengeanceLiveActionDelayMs = 12250;
+
+enum MediaPlaybackState
+{
+	Media_None = 0,
+	Media_VengeanceStartup = 1,
+	Media_VengeanceLiveAction = 2
+};
+
+bool IsVengeanceProcess ()
+{
+	char executablePath[MAX_PATH] = {};
+	DWORD length = GetModuleFileNameA (NULL, executablePath, MAX_PATH);
+	if (length == 0 || length >= MAX_PATH) return false;
+	const char* pName = executablePath;
+	for (const char* p = executablePath; *p != '\0'; p++) {
+		if (*p == '\\' || *p == '/') pName = p + 1;
+	}
+	return _stricmp (pName, "MW4.exe") == 0;
+}
+
+LONG ProbeMediaPlaybackState ()
+{
+	static volatile LONG64 nextProbeTick = 0;
+	const LONG64 now = (LONG64) GetTickCount64 ();
+	const LONG64 next = InterlockedCompareExchange64 (&nextProbeTick, 0, 0);
+	if (now < next) {
+		return InterlockedCompareExchange (&mediaPlaybackState, 0, 0);
+	}
+	if (InterlockedCompareExchange64 (&nextProbeTick, now + 50, next) != next) {
+		return InterlockedCompareExchange (&mediaPlaybackState, 0, 0);
+	}
+
+	LONG observed = Media_None;
+	if (IsVengeanceProcess ()) {
+		HANDLE hFile = CreateFileA ("Content\\Movies\\GAMEOPEN.MPG", GENERIC_READ, 0,
+			NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+		if (hFile != INVALID_HANDLE_VALUE) {
+			CloseHandle (hFile);
+		} else if (GetLastError () == ERROR_SHARING_VIOLATION) {
+			LONG64 began = InterlockedCompareExchange64 (&vengeanceOpeningObservedTick, 0, 0);
+			if (began == 0) {
+				InterlockedCompareExchange64 (&vengeanceOpeningObservedTick, now, 0);
+				began = InterlockedCompareExchange64 (&vengeanceOpeningObservedTick, 0, 0);
+			}
+			// GAMEOPEN.MPG embeds the Microsoft/FASA splash in its first 12.25
+			// seconds. Keep that segment on the ordinary 4:3 path and apply the
+			// sole widescreen exception only when the live-action sequence begins.
+			if (now - began >= vengeanceLiveActionDelayMs) {
+				observed = Media_VengeanceLiveAction;
+			} else {
+				observed = Media_VengeanceStartup;
+			}
+		} else {
+			InterlockedExchange64 (&vengeanceOpeningObservedTick, 0);
+		}
+	} else {
+		InterlockedExchange64 (&vengeanceOpeningObservedTick, 0);
+	}
+	InterlockedExchange (&mediaPlaybackState, observed);
+	return observed;
+}
+
+bool IsGameplay3DActive ()
+{
+	return InterlockedCompareExchange (&direct3DDeviceCount, 0, 0) > 0;
+}
 
