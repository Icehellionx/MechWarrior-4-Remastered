+void	Presenter::IReleaseIntroTexture (AdapterData& adapter, SwapchainEntry& swapchain)
+{
+	if (swapchain.pIntroTexture == NULL) {
+		return;
+	}
+	pD3D12Root->RTResourceDestroyed (swapchain.pIntroTexture, true);
+	adapter.pSRVDescAllocator->DeallocDescriptorGroup (swapchain.hIntroTextureSRV, 1);
+	adapter.pRTVDescAllocator->DeallocDescriptorGroup (swapchain.hIntroTextureRTV, 1);
+	swapchain.pIntroTexture->Release ();
+	swapchain.pIntroTexture = NULL;
+	swapchain.hIntroTextureSRV = (UInt32) -1;
+	swapchain.hIntroTextureRTV = (UInt32) -1;
+	swapchain.introTextureWidth = 0;
+	swapchain.introTextureHeight = 0;
+}
+
+
+bool	Presenter::IEnsureIntroTexture (AdapterData& adapter, SwapchainEntry& swapchain, UInt32 width, UInt32 height)
+{
+	if (swapchain.pIntroTexture != NULL &&
+		swapchain.introTextureWidth == width && swapchain.introTextureHeight == height) {
+		return true;
+	}
+	IReleaseIntroTexture (adapter, swapchain);
+
+	D3D12_HEAP_PROPERTIES heapProp =
+	{
+		D3D12_HEAP_TYPE_DEFAULT, D3D12_CPU_PAGE_PROPERTY_UNKNOWN, D3D12_MEMORY_POOL_UNKNOWN, 0, 0
+	};
+	D3D12_RESOURCE_DESC desc =
+	{
+		D3D12_RESOURCE_DIMENSION_TEXTURE2D, D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT,
+		width, height, 1, 1, swapchain.properties.format, { 1, 0 },
+		D3D12_TEXTURE_LAYOUT_UNKNOWN, D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET
+	};
+	HRESULT hr = adapter.pDevice->CreateCommittedResource (
+		&heapProp, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COMMON,
+		NULL, __uuidof(ID3D12Resource), (void**) &swapchain.pIntroTexture);
+	if (FAILED (hr)) {
+		return false;
+	}
+
+	swapchain.hIntroTextureSRV = adapter.pSRVDescAllocator->AllocDescriptorGroup (1);
+	swapchain.hIntroTextureRTV = adapter.pRTVDescAllocator->AllocDescriptorGroup (1);
+	if (swapchain.hIntroTextureSRV == (UInt32) -1 || swapchain.hIntroTextureRTV == (UInt32) -1) {
+		if (swapchain.hIntroTextureSRV != (UInt32) -1) adapter.pSRVDescAllocator->DeallocDescriptorGroup (swapchain.hIntroTextureSRV, 1);
+		if (swapchain.hIntroTextureRTV != (UInt32) -1) adapter.pRTVDescAllocator->DeallocDescriptorGroup (swapchain.hIntroTextureRTV, 1);
+		swapchain.pIntroTexture->Release ();
+		swapchain.pIntroTexture = NULL;
+		return false;
+	}
+
+	D3D12_SHADER_RESOURCE_VIEW_DESC srvDesc =
+	{
+		swapchain.properties.format, D3D12_SRV_DIMENSION_TEXTURE2D, D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING
+	};
+	srvDesc.Texture2D.MipLevels = 1;
+	adapter.pDevice->CreateShaderResourceView (
+		swapchain.pIntroTexture, &srvDesc,
+		adapter.pSRVDescAllocator->GetCPUDescHandle (swapchain.hIntroTextureSRV));
+	adapter.pDevice->CreateRenderTargetView (
+		swapchain.pIntroTexture, NULL,
+		adapter.pRTVDescAllocator->GetCPUDescHandle (swapchain.hIntroTextureRTV));
+
+	swapchain.introTextureState = D3D12_RESOURCE_STATE_COMMON;
+	swapchain.introTextureWidth = width;
+	swapchain.introTextureHeight = height;
+	return true;
+}
