 #define		VBUFFER_VERTEXCNT		256
 
+struct MonitorWindowSearch
+{
+	DWORD processID;
+	HWND window;
+	LONG64 area;
+};
+
+BOOL CALLBACK FindLargestProcessWindow (HWND window, LPARAM parameter)
+{
+	MonitorWindowSearch* pSearch = (MonitorWindowSearch*) parameter;
+	DWORD ownerProcessID = 0;
+	GetWindowThreadProcessId (window, &ownerProcessID);
+	if (ownerProcessID != pSearch->processID || !IsWindowVisible (window)) {
+		return TRUE;
+	}
+	RECT rect = {};
+	if (!GetWindowRect (window, &rect)) {
+		return TRUE;
+	}
+	const LONG64 width = max (0L, rect.right - rect.left);
+	const LONG64 height = max (0L, rect.bottom - rect.top);
+	const LONG64 area = width * height;
+	if (area > pSearch->area) {
+		pSearch->window = window;
+		pSearch->area = area;
+	}
+	return TRUE;
+}
+
+float GetTargetMonitorAspectRatio ()
+{
+	MonitorWindowSearch search = { GetCurrentProcessId (), NULL, 0 };
+	EnumWindows (FindLargestProcessWindow, (LPARAM) &search);
+	if (search.window != NULL) {
+		HMONITOR monitor = MonitorFromWindow (search.window, MONITOR_DEFAULTTONEAREST);
+		MONITORINFO info = { sizeof (MONITORINFO) };
+		if (monitor != NULL && GetMonitorInfo (monitor, &info)) {
+			const LONG width = info.rcMonitor.right - info.rcMonitor.left;
+			const LONG height = info.rcMonitor.bottom - info.rcMonitor.top;
+			if (width > 0 && height > 0) {
+				return (float) width / (float) height;
+			}
+		}
+	}
+	return 16.0f / 9.0f;
+}
+
