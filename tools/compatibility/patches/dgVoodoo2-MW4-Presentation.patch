+		ID3D12GraphicsCommandList* pCmdList = pCmdListAuto->GetCommandListInterface ();
+		if (forceUpdate) pCmdList->SetGraphicsRootSignature (adapter.pRootSignature);
+
+		bool updatePSO = forceUpdate;
+		const D3D12_RESOURCE_DESC finalTargetDesc = iCtx.drawingTarget.pDstTexture->GetDesc ();
+		const DXGI_FORMAT rtvFormat = finalTargetDesc.Format;
+		if (adapter.graphicsPipeline.RTVFormats[0] != rtvFormat) {
+			adapter.graphicsPipeline.RTVFormats[0] = rtvFormat;
+			adapter.pPSO = pD3D12Root->PLCacheGetGraphicsPipeline (adapterID, adapter.graphicsPipeline);
+			updatePSO = true;
+		}
+		if (updatePSO) pCmdList->SetPipelineState (adapter.pPSO);
+
+		D3D12_RESOURCE_BARRIER barriers[3];
+		UInt32 numBarriers = 0;
+		if ((adapter.glassTexState & D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE) == 0) {
+			IAddTransitionBarrier (adapter.pGlassTexture, adapter.glassTexState,
+				D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, barriers, numBarriers++);
+			adapter.glassTexState = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+		}
+		if ((swapchain.introTextureState & D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE) == 0) {
+			IAddTransitionBarrier (swapchain.pIntroTexture, swapchain.introTextureState,
+				D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, barriers, numBarriers++);
+			swapchain.introTextureState = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+		}
+		if ((iCtx.drawingTarget.dstTextureState & D3D12_RESOURCE_STATE_RENDER_TARGET) == 0) {
+			IAddTransitionBarrier (iCtx.drawingTarget.pDstTexture, iCtx.drawingTarget.dstTextureState,
+				D3D12_RESOURCE_STATE_RENDER_TARGET, barriers, numBarriers++);
+		}
+		if (numBarriers != 0) pCmdList->ResourceBarrier (numBarriers, barriers);
+
+		if (forceUpdate) {
+			pCmdList->IASetPrimitiveTopology (D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+			pCmdList->SetGraphicsRoot32BitConstants (1, 4, &rootPSConstBuffer, 0);
+		}
+		D3D12_VERTEX_BUFFER_VIEW vbView[] = {
+			lData.gpuAddress, VBUFFER_VERTEXCNT * sizeof (Vertex), sizeof (Vertex)
+		};
+		pCmdList->IASetVertexBuffers (0, 1, vbView);
+		pCmdList->SetDescriptorHeaps (1, &rdData.pHeap);
+		pCmdList->SetGraphicsRootDescriptorTable (0, rdData.gpuDescHandle);
+		pCmdList->OMSetRenderTargets (1, &iCtx.drawingTarget.rtvCPUHandle, TRUE, NULL);
+		// PresentEnd exposes the final swapchain texture, while dstRect still
+		// describes the ordinary centered 4:3 game viewport. This one movie is
+		// intentionally drawn across the complete final texture.
+		const RECT dstRect = { 0, 0, (LONG) finalTargetDesc.Width, (LONG) finalTargetDesc.Height };
+		pCmdList->RSSetScissorRects (1, &dstRect);
+		D3D12_VIEWPORT vp = { (FLOAT) dstRect.left, (FLOAT) dstRect.top,
+			(FLOAT) (dstRect.right - dstRect.left), (FLOAT) (dstRect.bottom - dstRect.top), 0.0f, 1.0f };
+		pCmdList->RSSetViewports (1, &vp);
+		pCmdList->DrawInstanced (4, 1, adapter.vbPos, 0);
+		adapter.vbPos += 4;
+
+		if ((iCtx.drawingTarget.dstTextureState & D3D12_RESOURCE_STATE_RENDER_TARGET) == 0) {
+			D3D12_RESOURCE_BARRIER restoreBarrier;
+			IAddTransitionBarrier (iCtx.drawingTarget.pDstTexture, D3D12_RESOURCE_STATE_RENDER_TARGET,
+				iCtx.drawingTarget.dstTextureState, &restoreBarrier, 0);
+			pCmdList->ResourceBarrier (1, &restoreBarrier);
+		}
+		pCmdListAuto->AFlushUnlock ();
+	}
+	adapter.pVertexBuffer->Unlock ();
 }
 
 
